# ==========================================
# Task Manager Web Application - Environment Variables
# ==========================================

# Server Port
PORT=3000
NODE_ENV=development

# ------------------------------------------
# Database Configuration
# ------------------------------------------
# Configurable connection string for MongoDB Community Server or MongoDB Atlas
# Default local development connection:
MONGO_URI=mongodb://127.0.0.1:27017/task_manager

# ------------------------------------------
# Authentication & Security
# ------------------------------------------
# Secret key used for signing JWT tokens (replace with a secure random string)
JWT_SECRET=replace-with-a-long-random-secret

# Initial Administrator Credentials (Bootstrap)
# When the server initializes, an admin user with these credentials will be ready
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-strong-password

# ------------------------------------------
# AI Task Description Generator (Groq API)
# ------------------------------------------
# Obtain your free API key from https://console.groq.com/
GROQ_API_KEY=PASTE_YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------
# Google AI Studio Injected Variables
# ------------------------------------------
# GEMINI_API_KEY: Automatically available in AI Studio, used as fallback for AI features
GEMINI_API_KEY=MY_GEMINI_API_KEY

# APP_URL: The URL where this applet is hosted
APP_URL=MY_APP_URL
