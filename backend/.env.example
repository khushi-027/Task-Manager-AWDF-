# Backend Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local Community Server or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/task_manager

# JWT Secret Key
JWT_SECRET=replace-with-a-long-random-secret

# Initial Administrator Credentials (Bootstrap)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-strong-password

# Groq Cloud AI API Configuration (Task Description Generator)
# Get your API key at: https://console.groq.com/
GROQ_API_KEY=PASTE_YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=llama-3.3-70b-versatile
